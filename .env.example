# CRYPTIX — Environment Configuration Example
# Copy this file to .env and adjust values as needed.
# Never commit your actual .env to version control.

# ── Flask ─────────────────────────────────────────────────────────────────────
# If set, overrides the persisted instance/secret.key.
# Leave blank to let CRYPTIX manage the key automatically.
SECRET_KEY=

# Set to True only during development
DEBUG=False

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_IDLE_MINUTES=10
SESSION_ABSOLUTE_MINUTES=60

# ── Proof-of-Work ─────────────────────────────────────────────────────────────
POW_DIFFICULTY=3

# ── Authentication ────────────────────────────────────────────────────────────
# Require a registered USB token on every login
USB_REQUIRED=False

# Face confidence threshold (LBPH; lower = stricter)
FACE_CONFIDENCE_THRESHOLD=70.0

# Biometric policy: all_enrolled | any_enrolled | disabled
BIOMETRIC_POLICY=all_enrolled

# ── Key Derivation ────────────────────────────────────────────────────────────
PBKDF2_ITERATIONS=600000
KEK_PBKDF2_ITERATIONS=600000
SUPER_ENC_PBKDF2_ITERATIONS=200000

# ── WebAuthn / Passkey ────────────────────────────────────────────────────────
RP_ID=localhost
RP_ORIGIN=http://localhost:5000

# ── Developer mode ────────────────────────────────────────────────────────────
CRYPTIX_DEV_MODE=False
# DEV_DONGLE_DIR=C:\path\to\fake\dongle

# ── Media ─────────────────────────────────────────────────────────────────────
WINAMP_PATH=C:\Program Files (x86)\Winamp\winamp.exe
